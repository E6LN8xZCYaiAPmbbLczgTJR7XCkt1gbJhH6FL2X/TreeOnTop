local ReplicatedStorage = game:GetService("ReplicatedStorage")
local equipEvent = ReplicatedStorage.rEvents.equipPetEvent
local petsFolder = LocalPlayer.petsFolder

local function EquipPets(petName)
    for _, folder in pairs(petsFolder:GetChildren()) do
        if folder:IsA("Folder") then
            for _, pet in pairs(folder:GetChildren()) do
                equipEvent:FireServer("unequipPet", pet)
            end
        end
    end
    wait(0.002)
    local petsToEquip = {}
    local targetName = string.lower(petName)
    for _, pet in pairs(petsFolder.Unique:GetChildren()) do
        if string.lower(pet.Name) == targetName then
            table.insert(petsToEquip, pet)
        end
    end
    for i = 1, math.min(8, #petsToEquip) do
        equipEvent:FireServer("equipPet", petsToEquip[i])
        wait(0.001)
    end
end

KillingTab:Button({
    Title = "Equip Wild Wizards",
    Callback = function()
        EquipPets("Wild Wizard")
    end
})

KillingTab:Button({
    Title = "Equip Mighty Monsters",
    Callback = function()
        EquipPets("Mighty Monster")
    end
})

local packSpam = false
local currentPet = "Mighty Monster"

KillingTab:Toggle({
    Title = "Pack Spam (WW/MM)",
    Value = false,
    Callback = function(state)
        packSpam = state
        if state then
            spawn(function()
                local petsMM = {}
                local petsWW = {}
                local lastRefresh = 0
                while packSpam do
                    if tick() - lastRefresh > 3 then
                        for _, folder in pairs(petsFolder:GetChildren()) do
                            if folder:IsA("Folder") then
                                for _, pet in pairs(folder:GetChildren()) do
                                    pcall(equipEvent.FireServer, equipEvent, "unequipPet", pet)
                                end
                            end
                        end
                        table.clear(petsMM)
                        table.clear(petsWW)
                        for _, pet in pairs(petsFolder.Unique:GetChildren()) do
                            if pet.Name == "Mighty Monster" then
                                table.insert(petsMM, pet)
                            elseif pet.Name == "Wild Wizard" then
                                table.insert(petsWW, pet)
                            end
                        end
                        lastRefresh = tick()
                    end
                    local petsToEquip = currentPet == "Mighty Monster" and petsMM or petsWW
                    local petsToUnequip = currentPet == "Mighty Monster" and petsWW or petsMM
                    local otherPet = currentPet == "Mighty Monster" and "Wild Wizard" or "Mighty Monster"
                    local max = math.min(8, #petsToEquip, #petsToUnequip)
                    local delay = currentPet == "Wild Wizard" and 0.001 or 0.002
                    for i = 1, max do
                        local unequipPet = petsToUnequip[i]
                        local equipPet = petsToEquip[i]
                        if unequipPet and unequipPet.Parent then
                            pcall(equipEvent.FireServer, equipEvent, "unequipPet", unequipPet)
                        end
                        if equipPet and equipPet.Parent then
                            pcall(equipEvent.FireServer, equipEvent, "equipPet", equipPet)
                        end
                        wait(delay)
                    end
                    currentPet = otherPet
                end
            end)
        end
    end
})

