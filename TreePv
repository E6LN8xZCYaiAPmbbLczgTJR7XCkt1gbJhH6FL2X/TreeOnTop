_G.BlacklistedPlayers = _G.BlacklistedPlayers or {}
_G.TpListedPlayers = _G.TpListedPlayers or {}
_G.WatchlistedPlayers = _G.WatchlistedPlayers or {}

local function IsBlacklisted(Player)
    for _, Name in ipairs(_G.BlacklistedPlayers) do
        if Name:lower() == Player.DisplayName:lower() then
            return true
        end
    end
    return false
end

local function IsTpListed(Player)
    for _, Name in ipairs(_G.TpListedPlayers) do
        if Name:lower() == Player.DisplayName:lower() then
            return true
        end
    end
    return false
end

local function IsWatchlisted(Player)
    local NameLower = Player.Name:lower()
    local DisplayLower = Player.DisplayName:lower()
    for _, Entry in ipairs(_G.WatchlistedPlayers) do
        local Cl = Entry:lower()
        if NameLower:find(Cl, 1, true) or DisplayLower:find(Cl, 1, true) then
            return true
        end
    end
    return false
end

local function GetPlayerDisplayText(Player)
    return Player.DisplayName
end

local function GetPlayerList()
    local list = {}
    for _, Player in ipairs(Players:GetPlayers()) do
        if Player ~= LocalPlayer then
            table.insert(list, GetPlayerDisplayText(Player))
        end
    end
    return list
end

local BlacklistDropdown = KillingTab:Dropdown({
    Title = "Add To Blacklist",
