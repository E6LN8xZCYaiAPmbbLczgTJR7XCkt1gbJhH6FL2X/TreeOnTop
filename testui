--[[
    Zenith UI Library
    Ordered by visual appearance (top → bottom / outside → inside)
]]

local TweenService     = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local CoreGui          = game:GetService("CoreGui")
local RunService       = game:GetService("RunService")

----------------------------------------------------------------
-- Theme
----------------------------------------------------------------
local Theme = {
	Background        = Color3.fromRGB(18, 26, 34),
	HeaderBackground  = Color3.fromRGB(14, 22, 30),
	SidebarBackground = Color3.fromRGB(12, 19, 27),
	ButtonBackground  = Color3.fromRGB(25, 36, 47),
	InputBackground   = Color3.fromRGB(20, 30, 40),
	AccentStroke      = Color3.fromRGB(137, 207, 240),
	AccentFill        = Color3.fromRGB(137, 207, 240),
	AccentSelected    = Color3.fromRGB(22, 52, 72),
	TextPrimary       = Color3.fromRGB(255, 255, 255),
	TextSecondary     = Color3.fromRGB(168, 190, 205),
	TextMuted         = Color3.fromRGB(225, 236, 242),
	Divider           = Color3.fromRGB(36, 50, 62),
	Font              = Enum.Font.GothamBlack,
	FontBody          = Enum.Font.GothamBold,
}

----------------------------------------------------------------
-- Constants
----------------------------------------------------------------
local CORNER_RADIUS   = 10
local SMALL_CORNER    = 7
local MIN_WIDTH       = 420
local MIN_HEIGHT      = 300
local HEADER_HEIGHT   = 35
local FOOTER_HEIGHT   = 50
local TIMER_HEIGHT    = 22
local CONTENT_SPLIT   = 0.55

local DROPDOWN_OPEN   = "▾"
local DROPDOWN_CLOSED = "▸"

----------------------------------------------------------------
-- Helpers
----------------------------------------------------------------
local function Create(className, props)
	local instance = Instance.new(className)
	for key, value in pairs(props or {}) do
		instance[key] = value
	end
	return instance
end

local function AddCorner(parent, radius)
	return Create("UICorner", {
		Parent = parent,
		CornerRadius = UDim.new(0, radius or SMALL_CORNER),
	})
end

local function AddStroke(parent, color, thickness)
	return Create("UIStroke", {
		Parent = parent,
		Color = color or Theme.AccentStroke,
		Thickness = thickness or 1.5,
	})
end

local function FormatTime(seconds)
	seconds = math.max(0, math.floor(seconds))
	local days    = math.floor(seconds / 86400)
	local hours   = math.floor((seconds % 86400) / 3600)
	local minutes = math.floor((seconds % 3600) / 60)
	local secs    = seconds % 60
	return string.format("%dD / %dH / %dM / %dS", days, hours, minutes, secs)
end

----------------------------------------------------------------
-- Main Library
----------------------------------------------------------------
local Library = {}
Library.__index = Library

function Library.new(config)
	config = config or {}

	local self = setmetatable({}, Library)
	self.Tabs          = {}
	self.TabOffsets    = {}
	self.SelectedIndex = 1
	self.Dropdowns     = {}

	-------------------------------------------------
	-- 1. ScreenGui (root)
	-------------------------------------------------
	local screenGui = Create("ScreenGui", {
		Name = config.Name or "ZenithUILib",
		ResetOnSpawn = false,
		Parent = CoreGui,
	})
	self.ScreenGui = screenGui

	-------------------------------------------------
	-- 2. Floating Toggle / Minimizer Button
	-------------------------------------------------
	local toggleBtn = Create("TextButton", {
		Parent = screenGui,
		Size = UDim2.new(0, 45, 0, 45),
		Position = UDim2.new(0.05, 0, 0.1, 0),
		BackgroundColor3 = Theme.HeaderBackground,
		Text = "",
		AutoButtonColor = false,
	})
	AddCorner(toggleBtn, 12)

	Create("UIGradient", {
		Parent = toggleBtn,
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
			ColorSequenceKeypoint.new(1, Color3.new(0.75, 0.87, 0.93)),
		}),
		Rotation = 45,
	})

	local toggleStroke = AddStroke(toggleBtn)
	Create("UIGradient", {
		Parent = toggleStroke,
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.new(0.7, 0.9, 1)),
			ColorSequenceKeypoint.new(1, Color3.new(0.2, 0.5, 0.65)),
		}),
		Rotation = 45,
	})

	Create("TextLabel", {
		Parent = toggleBtn,
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = config.ToggleLabel or "M",
		Font = Theme.Font,
		TextSize = 26,
		TextColor3 = Theme.TextPrimary,
	})

	-- Toggle drag state
	local toggleDragging = false
	local toggleDragStart
	local toggleStartPos
	local toggleMoved = false

	toggleBtn.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			toggleDragging = true
			toggleMoved = false
			toggleDragStart = input.Position
			toggleStartPos = toggleBtn.Position
		end
	end)

	toggleBtn.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			toggleDragging = false
		end
	end)

	-------------------------------------------------
	-- 3. Main Panel
	-------------------------------------------------
	local width  = config.Width  or 680
	local height = config.Height or 460

	local panel = Create("Frame", {
		Parent = screenGui,
		Size = UDim2.new(0, width, 0, height),
		Position = UDim2.new(0.5, -width / 2, 0.5, -height / 2),
		BackgroundColor3 = Theme.Background,
		BorderSizePixel = 0,
		Active = true,
		ClipsDescendants = true,
		Visible = true,
	})
	AddCorner(panel, CORNER_RADIUS)
	AddStroke(panel)
	self.Panel = panel

	-------------------------------------------------
	-- 4. Header (title bar)
	-------------------------------------------------
	local header = Create("Frame", {
		Parent = panel,
		Size = UDim2.new(1, 0, 0, HEADER_HEIGHT),
		Position = UDim2.new(0, 0, 0, 0),
		BackgroundColor3 = Theme.HeaderBackground,
	})
	AddCorner(header, CORNER_RADIUS)

	Create("TextLabel", {
		Parent = header,
		Size = UDim2.new(1, -10, 1, 0),
		Position = UDim2.new(0, 8, 0, 0),
		BackgroundTransparency = 1,
		Text = config.Title or "Zenith UI",
		TextColor3 = Theme.TextPrimary,
		Font = Theme.Font,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
	})

	-------------------------------------------------
	-- 5. Sidebar (left)
	-------------------------------------------------
	local sidebar = Create("Frame", {
		Parent = panel,
		Size = UDim2.new(0, 140, 1, -(HEADER_HEIGHT + FOOTER_HEIGHT + TIMER_HEIGHT)),
		Position = UDim2.new(0, 0, 0, HEADER_HEIGHT),
		BackgroundColor3 = Theme.SidebarBackground,
	})

	-- Indicator bar
	local indicator = Create("Frame", {
		Parent = sidebar,
		Size = UDim2.new(0, 4, 0, 32),
		Position = UDim2.new(0, 5, 0, 10),
		BackgroundColor3 = Theme.AccentFill,
	})
	AddCorner(indicator, 2)
	self.Indicator = indicator

	-- Tab list
	local tabList = Create("ScrollingFrame", {
		Parent = sidebar,
		Size = UDim2.new(1, -5, 1, 0),
		BackgroundTransparency = 1,
		ScrollBarThickness = 0,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(0, 0, 0, 0),
	})
	Create("UIListLayout", { Parent = tabList, Padding = UDim.new(0, 5) })
	Create("UIPadding", { Parent = tabList, PaddingTop = UDim.new(0, 10) })
	self.TabList = tabList

	-------------------------------------------------
	-- 6. Content Area (right of sidebar)
	-------------------------------------------------
	local content = Create("Frame", {
		Parent = panel,
		Size = UDim2.new(1, -145, 1, -(HEADER_HEIGHT + FOOTER_HEIGHT + TIMER_HEIGHT)),
		Position = UDim2.new(0, 145, 0, HEADER_HEIGHT),
		BackgroundTransparency = 1,
	})
	self.Content = content

	-------------------------------------------------
	-- 7. Footer (avatar + text)
	-------------------------------------------------
	local footer = Create("Frame", {
		Parent = panel,
		Size = UDim2.new(1, 0, 0, FOOTER_HEIGHT),
		Position = UDim2.new(0, 0, 1, -(FOOTER_HEIGHT + TIMER_HEIGHT)),
		BackgroundColor3 = Theme.HeaderBackground,
	})

	local avatar = Create("ImageLabel", {
		Parent = footer,
		Size = UDim2.new(0, 34, 0, 34),
		Position = UDim2.new(0, 8, 0.5, -17),
		BackgroundColor3 = Theme.InputBackground,
		Image = config.AvatarImage or "",
	})
	AddCorner(avatar, 17)
	AddStroke(avatar, Theme.AccentStroke, 1)

	Create("TextLabel", {
		Parent = footer,
		Size = UDim2.new(1, -58, 1, 0),
		Position = UDim2.new(0, 50, 0, 0),
		BackgroundTransparency = 1,
		Text = config.FooterText or "",
		TextColor3 = Theme.TextPrimary,
		Font = Theme.Font,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
	})

	-------------------------------------------------
	-- 8. Timer Bar (bottom)
	-------------------------------------------------
	local timerBar = Create("Frame", {
		Parent = panel,
		Size = UDim2.new(1, 0, 0, TIMER_HEIGHT),
		Position = UDim2.new(0, 0, 1, -TIMER_HEIGHT),
		BackgroundColor3 = Theme.AccentSelected,
	})
	AddCorner(timerBar, CORNER_RADIUS)

	local timerLabel = Create("TextLabel", {
		Parent = timerBar,
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = "",
		TextColor3 = Theme.TextPrimary,
		Font = Theme.FontBody,
		TextSize = 12,
	})
	self.TimerLabel = timerLabel

	local startTime = os.clock()
	function self:ResetTimer()
		startTime = os.clock()
	end

	timerLabel.Text = FormatTime(0)
	local elapsed = 0
	RunService.Heartbeat:Connect(function(dt)
		elapsed += dt
		if elapsed >= 1 then
			elapsed -= 1
			timerLabel.Text = FormatTime(os.clock() - startTime)
		end
	end)

	-------------------------------------------------
	-- 9. Resize Handle (bottom-right corner)
	-------------------------------------------------
	local resizeHandle = Create("TextButton", {
		Parent = panel,
		Size = UDim2.new(0, 18, 0, 18),
		Position = UDim2.new(1, -18, 1, -18),
		BackgroundColor3 = Theme.AccentFill,
		AutoButtonColor = false,
		Text = "",
		ZIndex = 10,
	})
	AddCorner(resizeHandle, 4)

	-------------------------------------------------
	-- 10. Open / Close + Drag / Resize Logic
	-------------------------------------------------
	local isOpen = true

	toggleBtn.MouseButton1Click:Connect(function()
		if toggleMoved then return end
		isOpen = not isOpen
		panel.Visible = isOpen
	end)

	self.Open = function()
		isOpen = true
		panel.Visible = true
	end

	self.Close = function()
		isOpen = false
		panel.Visible = false
	end

	-- Panel drag
	local dragging, dragStart, startPos
	local resizing, resizeStart, startSize

	header.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = panel.Position
		end
	end)

	header.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	-- Resize
	resizeHandle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			resizing = true
			resizeStart = input.Position
			startSize = panel.Size
		end
	end)

	resizeHandle.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			resizing = false
		end
	end)

	-- Shared input movement
	UserInputService.InputChanged:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseMovement
			and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end

		if dragging then
			local delta = input.Position - dragStart
			panel.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y
			)
		elseif resizing then
			local delta = input.Position - resizeStart
			local newWidth  = math.max(MIN_WIDTH,  startSize.X.Offset + delta.X)
			local newHeight = math.max(MIN_HEIGHT, startSize.Y.Offset + delta.Y)
			panel.Size = UDim2.new(startSize.X.Scale, newWidth, startSize.Y.Scale, newHeight)
		elseif toggleDragging then
			local delta = input.Position - toggleDragStart
			if math.abs(delta.X) > 3 or math.abs(delta.Y) > 3 then
				toggleMoved = true
			end
			toggleBtn.Position = UDim2.new(
				toggleStartPos.X.Scale, toggleStartPos.X.Offset + delta.X,
				toggleStartPos.Y.Scale, toggleStartPos.Y.Offset + delta.Y
			)
		end
	end)

	return self
end

----------------------------------------------------------------
-- Tab Class
----------------------------------------------------------------
local Tab = {}
Tab.__index = Tab

function Library:AddTab(name)
	local index = #self.Tabs + 1

	local tabButton = Create("TextButton", {
		Parent = self.TabList,
		Size = UDim2.new(1, -15, 0, 32),
		BackgroundColor3 = Theme.ButtonBackground,
		BackgroundTransparency = 1,
		Text = "   " .. name,
		TextColor3 = Theme.TextSecondary,
		Font = Theme.Font,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	AddCorner(tabButton)

	tabButton.MouseEnter:Connect(function()
		if tabButton.BackgroundTransparency == 1 then
			TweenService:Create(tabButton, TweenInfo.new(0.15), {
				BackgroundTransparency = 0,
				BackgroundColor3 = Color3.fromRGB(20, 32, 44),
			}):Play()
		end
	end)

	tabButton.MouseLeave:Connect(function()
		if tabButton.TextColor3 ~= Theme.TextPrimary then
			TweenService:Create(tabButton, TweenInfo.new(0.15), {
				BackgroundTransparency = 1,
			}):Play()
		end
	end)

	local page = Create("Frame", {
		Parent = self.Content,
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Visible = index == 1,
	})

	-- Left column
	local mainColumn = Create("ScrollingFrame", {
		Parent = page,
		Size = UDim2.new(CONTENT_SPLIT, -4, 1, 0),
		Position = UDim2.new(0, 0, 0, 0),
		BackgroundTransparency = 1,
		ScrollBarThickness = 4,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(0, 0, 0, 0),
	})
	Create("UIListLayout", { Parent = mainColumn, Padding = UDim.new(0, 8) })
	Create("UIPadding", {
		Parent = mainColumn,
		PaddingTop = UDim.new(0, 8),
		PaddingLeft = UDim.new(0, 8),
		PaddingRight = UDim.new(0, 8),
	})

	-- Divider
	Create("Frame", {
		Parent = page,
		Size = UDim2.new(0, 1, 1, -12),
		Position = UDim2.new(CONTENT_SPLIT, 0, 0, 6),
		BackgroundColor3 = Theme.Divider,
		BorderSizePixel = 0,
	})

	-- Right column
	local sideColumn = Create("ScrollingFrame", {
		Parent = page,
		Size = UDim2.new(1 - CONTENT_SPLIT, -4, 1, 0),
		Position = UDim2.new(CONTENT_SPLIT, 4, 0, 0),
		BackgroundTransparency = 1,
		ScrollBarThickness = 4,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(0, 0, 0, 0),
	})
	Create("UIListLayout", { Parent = sideColumn, Padding = UDim.new(0, 8) })
	Create("UIPadding", {
		Parent = sideColumn,
		PaddingTop = UDim.new(0, 8),
		PaddingLeft = UDim.new(0, 8),
		PaddingRight = UDim.new(0, 8),
	})

	table.insert(self.Tabs, { Button = tabButton, Page = page })
	table.insert(self.TabOffsets, 10 + (index - 1) * 37)

	tabButton.MouseButton1Click:Connect(function()
		self:SelectTab(index)
	end)

	return setmetatable({
		Page    = page,
		Main    = mainColumn,
		Side    = sideColumn,
		Library = self,
	}, Tab)
end

function Library:SelectTab(index)
	self.SelectedIndex = index

	for i, tabData in ipairs(self.Tabs) do
		tabData.Page.Visible = (i == index)

		if i == index then
			TweenService:Create(tabData.Button, TweenInfo.new(0.15), {
				BackgroundTransparency = 0,
				BackgroundColor3 = Theme.AccentSelected,
				TextColor3 = Theme.TextPrimary,
			}):Play()
		else
			TweenService:Create(tabData.Button, TweenInfo.new(0.15), {
				BackgroundTransparency = 1,
				TextColor3 = Theme.TextSecondary,
			}):Play()
		end
	end

	TweenService:Create(self.Indicator, TweenInfo.new(0.2), {
		Position = UDim2.new(0, 5, 0, self.TabOffsets[index] or 10),
	}):Play()
end

----------------------------------------------------------------
-- Components (in typical usage order)
----------------------------------------------------------------

function Tab:AddSectionLabel(text, useSide)
	local parent = useSide and self.Side or self.Main

	return Create("TextLabel", {
		Parent = parent,
		Size = UDim2.new(1, 0, 0, 22),
		BackgroundTransparency = 1,
		Text = text,
		TextColor3 = Theme.AccentFill,
		Font = Theme.FontBody,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
end

function Tab:AddButton(text, callback, useSide)
	local parent = useSide and self.Side or self.Main

	local button = Create("TextButton", {
		Parent = parent,
		Size = UDim2.new(1, 0, 0, 36),
		BackgroundColor3 = Theme.ButtonBackground,
		Text = "   " .. text,
		TextColor3 = Theme.TextMuted,
		Font = Theme.FontBody,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	AddCorner(button)
	AddStroke(button, Color3.fromRGB(45, 62, 76), 1)

	button.Activated:Connect(function()
		if callback then callback() end
	end)

	return button
end

function Tab:AddToggle(text, callback, useSide)
	local parent = useSide and self.Side or self.Main

	local button = Create("TextButton", {
		Parent = parent,
		Size = UDim2.new(1, 0, 0, 36),
		BackgroundColor3 = Theme.ButtonBackground,
		Text = "   " .. text,
		TextColor3 = Theme.TextMuted,
		Font = Theme.FontBody,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	AddCorner(button)

	local box = Create("Frame", {
		Parent = button,
		Size = UDim2.new(0, 16, 0, 16),
		Position = UDim2.new(1, -28, 0.5, -8),
		BackgroundColor3 = Theme.InputBackground,
	})
	AddCorner(box, 4)

	local check = Create("TextLabel", {
		Parent = box,
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = "",
		TextColor3 = Theme.TextPrimary,
		Font = Theme.Font,
		TextSize = 12,
	})

	local enabled = false
	button.Activated:Connect(function()
		enabled = not enabled
		check.Text = enabled and "X" or ""
		box.BackgroundColor3 = enabled and Theme.AccentFill or Theme.InputBackground
		if callback then callback(enabled) end
	end)

	return button
end

function Tab:AddTextbox(label, placeholder, callback, useSide)
	local parent = useSide and self.Side or self.Main

	local container = Create("Frame", {
		Parent = parent,
		Size = UDim2.new(1, 0, 0, 36),
		BackgroundColor3 = Theme.ButtonBackground,
	})
	AddCorner(container)
	AddStroke(container, Color3.fromRGB(45, 62, 76), 1)

	Create("TextLabel", {
		Parent = container,
		Size = UDim2.new(0.45, 0, 1, 0),
		Position = UDim2.new(0, 10, 0, 0),
		BackgroundTransparency = 1,
		Text = label,
		TextColor3 = Theme.TextMuted,
		Font = Theme.FontBody,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
	})

	local textBox = Create("TextBox", {
		Parent = container,
		Size = UDim2.new(0.5, -14, 0, 24),
		Position = UDim2.new(0.5, 0, 0.5, -12),
		BackgroundColor3 = Theme.InputBackground,
		TextColor3 = Theme.TextPrimary,
		PlaceholderText = placeholder or "",
		PlaceholderColor3 = Theme.TextSecondary,
		Font = Theme.FontBody,
		TextSize = 12,
		Text = "",
		ClearTextOnFocus = false,
	})
	AddCorner(textBox, 5)

	textBox.FocusLost:Connect(function(enterPressed)
		if callback then callback(textBox.Text, enterPressed) end
	end)

	return textBox
end

function Tab:AddSlider(label, min, max, default, callback, useSide)
	local parent = useSide and self.Side or self.Main
	min     = min or 0
	max     = max or 100
	default = math.clamp(default or min, min, max)

	local container = Create("Frame", {
		Parent = parent,
		Size = UDim2.new(1, 0, 0, 52),
		BackgroundColor3 = Theme.ButtonBackground,
	})
	AddCorner(container)
	AddStroke(container, Color3.fromRGB(45, 62, 76), 1)

	Create("TextLabel", {
		Parent = container,
		Size = UDim2.new(1, -70, 0, 20),
		Position = UDim2.new(0, 10, 0, 4),
		BackgroundTransparency = 1,
		Text = label,
		TextColor3 = Theme.TextMuted,
		Font = Theme.FontBody,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
	})

	local valueBox = Create("TextBox", {
		Parent = container,
		Size = UDim2.new(0, 50, 0, 20),
		Position = UDim2.new(1, -60, 0, 4),
		BackgroundColor3 = Theme.InputBackground,
		TextColor3 = Theme.TextPrimary,
		Font = Theme.FontBody,
		TextSize = 12,
		Text = tostring(default),
		ClearTextOnFocus = false,
	})
	AddCorner(valueBox, 5)

	local track = Create("Frame", {
		Parent = container,
		Size = UDim2.new(1, -20, 0, 6),
		Position = UDim2.new(0, 10, 1, -14),
		BackgroundColor3 = Theme.InputBackground,
	})
	AddCorner(track, 3)

	local fill = Create("Frame", {
		Parent = track,
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = Theme.AccentFill,
	})
	AddCorner(fill, 3)

	local thumb = Create("Frame", {
		Parent = track,
		Size = UDim2.new(0, 12, 0, 12),
		Position = UDim2.new(0, -6, 0.5, -6),
		BackgroundColor3 = Theme.TextPrimary,
		ZIndex = 5,
	})
	AddCorner(thumb, 6)

	local current = default

	local function setValue(value, skipText)
		value = math.clamp(value, min, max)
		current = value
		local alpha = (max - min) == 0 and 0 or (value - min) / (max - min)
		fill.Size = UDim2.new(alpha, 0, 1, 0)
		thumb.Position = UDim2.new(alpha, -6, 0.5, -6)
		if not skipText then
			valueBox.Text = tostring(math.floor(value * 100) / 100)
		end
		if callback then callback(value) end
	end
	setValue(default)

	local sliding = false

	local function updateFromX(x)
		local alpha = (x - track.AbsolutePosition.X) / track.AbsoluteSize.X
		setValue(min + alpha * (max - min))
	end

	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			sliding = true
			updateFromX(input.Position.X)
		end
	end)

	track.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			sliding = false
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			updateFromX(input.Position.X)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			sliding = false
		end
	end)

	valueBox.FocusLost:Connect(function()
		local num = tonumber(valueBox.Text)
		if num then
			setValue(num, true)
			valueBox.Text = tostring(current)
		else
			valueBox.Text = tostring(current)
		end
	end)

	return {
		Set = setValue,
		Get = function() return current end,
	}
end

function Tab:AddDropdown(title, options, useSide, multiSelect)
	if useSide == nil then useSide = true end
	local parent = useSide and self.Side or self.Main
	local lib = self.Library

	local OPTION_HEIGHT = 24
	local OPTION_PAD    = 2
	local MAX_HEIGHT    = 150

	local container = Create("Frame", {
		Parent = parent,
		Size = UDim2.new(1, 0, 0, 26),
		BackgroundTransparency = 1,
		AutomaticSize = Enum.AutomaticSize.Y,
		ZIndex = 2,
	})
	Create("UIListLayout", { Parent = container, Padding = UDim.new(0, 4) })

	local headerBtn = Create("TextButton", {
		Parent = container,
		Size = UDim2.new(1, 0, 0, 26),
		BackgroundColor3 = Theme.ButtonBackground,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 2,
	})
	AddCorner(headerBtn)

	local headerLabel = Create("TextLabel", {
		Parent = headerBtn,
		Size = UDim2.new(1, -10, 1, 0),
		Position = UDim2.new(0, 10, 0, 0),
		BackgroundTransparency = 1,
		Text = title .. "  " .. DROPDOWN_OPEN,
		TextColor3 = Theme.AccentFill,
		Font = Theme.FontBody,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 2,
	})

	local closeFrame = Create("Frame", {
		Parent = container,
		Size = UDim2.new(1, 0, 0, 20),
		BackgroundTransparency = 1,
		ZIndex = 2,
	})

	local closeBtn = Create("TextButton", {
		Parent = closeFrame,
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundColor3 = Theme.InputBackground,
		Text = "Close  ×",
		TextColor3 = Theme.TextSecondary,
		Font = Theme.FontBody,
		TextSize = 12,
		ZIndex = 2,
	})
	AddCorner(closeBtn, 4)

	local list = Create("ScrollingFrame", {
		Parent = container,
		Size = UDim2.new(1, 0, 0, 0),
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 4,
		BackgroundColor3 = Theme.InputBackground,
		ClipsDescendants = true,
		Visible = true,
		ZIndex = 2,
	})
	AddCorner(list, 6)
	Create("UIListLayout", { Parent = list, Padding = UDim.new(0, OPTION_PAD) })
	Create("UIPadding", {
		Parent = list,
		PaddingTop = UDim.new(0, 4),
		PaddingBottom = UDim.new(0, 4),
		PaddingLeft = UDim.new(0, 4),
		PaddingRight = UDim.new(0, 4),
	})

	local dropdown = {
		Frame       = container,
		Content     = list,
		MultiSelect = multiSelect and true or false,
		Selected    = {},
		_options    = {},
	}

	local isOpen = true

	local function updateHeight()
		local count = #dropdown._options
		local h = 0
		if count > 0 then
			h = math.min(count * OPTION_HEIGHT + (count - 1) * OPTION_PAD + 8, MAX_HEIGHT)
		end
		list.Size = UDim2.new(1, 0, 0, h)
	end

	local function setZIndex(z)
		container.ZIndex = z
		headerBtn.ZIndex = z
		headerLabel.ZIndex = z
		closeFrame.ZIndex = z
		closeBtn.ZIndex = z
		list.ZIndex = z
		for _, child in ipairs(list:GetChildren()) do
			if child:IsA("GuiObject") then
				child.ZIndex = z
			end
		end
	end

	function dropdown:SetOpen(open)
		isOpen = open
		list.Visible = open
		closeFrame.Visible = open
		headerLabel.Text = title .. "  " .. (open and DROPDOWN_OPEN or DROPDOWN_CLOSED)
		setZIndex(open and 10 or 2)

		if open and lib then
			for _, other in ipairs(lib.Dropdowns) do
				if other ~= dropdown and other._IsExpanded and other._IsExpanded() then
					other:SetOpen(false)
				end
			end
		end
	end

	dropdown._IsExpanded = function()
		return isOpen
	end

	function dropdown:AddOption(text, callback)
		local optBtn = Create("TextButton", {
			Parent = list,
			Size = UDim2.new(1, 0, 0, OPTION_HEIGHT),
			BackgroundTransparency = 1,
			Text = "  " .. text,
			TextColor3 = Color3.fromRGB(198, 214, 224),
			Font = Enum.Font.Gotham,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = isOpen and 10 or 2,
			AutoButtonColor = false,
		})

		local selected = false
		local optionRef

		local function refreshVisual()
			if selected then
				optBtn.BackgroundTransparency = 0
				optBtn.BackgroundColor3 = Theme.AccentSelected
				optBtn.TextColor3 = Theme.TextPrimary
				optBtn.Text = (dropdown.MultiSelect and "✓ " or "  ") .. text
			else
				optBtn.BackgroundTransparency = 1
				optBtn.TextColor3 = Color3.fromRGB(198, 214, 224)
				optBtn.Text = "  " .. text
			end
		end

		local function setSelected(value)
			selected = value
			refreshVisual()
			dropdown.Selected[text] = value or nil
		end

		optBtn.MouseEnter:Connect(function()
			if not selected then
				optBtn.BackgroundTransparency = 0
				optBtn.BackgroundColor3 = Color3.fromRGB(20, 32, 44)
			end
		end)

		optBtn.MouseLeave:Connect(function()
			if not selected then
				optBtn.BackgroundTransparency = 1
			end
		end)

		optBtn.Activated:Connect(function()
			if dropdown.MultiSelect then
				setSelected(not selected)
				if callback then callback(selected) end
			else
				for _, opt in ipairs(dropdown._options) do
					if opt ~= optionRef then
						opt.SetSelected(false)
					end
				end
				setSelected(true)
				if callback then callback() end
			end
		end)

		optionRef = { Button = optBtn, Text = text, SetSelected = setSelected }
		table.insert(dropdown._options, optionRef)
		updateHeight()
		return optBtn
	end

	function dropdown:RemoveOption(button)
		if not button then return end
		for i, opt in ipairs(dropdown._options) do
			if opt.Button == button then
				dropdown.Selected[opt.Text] = nil
				table.remove(dropdown._options, i)
				break
			end
		end
		button:Destroy()
		updateHeight()
	end

	function dropdown:Clear()
		for _, child in ipairs(list:GetChildren()) do
			if child:IsA("TextButton") then
				child:Destroy()
			end
		end
		dropdown._options = {}
		dropdown.Selected = {}
		updateHeight()
	end

	function dropdown:GetSelected()
		local result = {}
		for _, opt in ipairs(dropdown._options) do
			if dropdown.Selected[opt.Text] then
				table.insert(result, opt.Text)
			end
		end
		return result
	end

	headerBtn.Activated:Connect(function()
		dropdown:SetOpen(not isOpen)
	end)

	closeBtn.Activated:Connect(function()
		dropdown:SetOpen(false)
	end)

	if options then
		for _, opt in ipairs(options) do
			dropdown:AddOption(opt.Text, opt.Callback)
		end
	end

	if lib then
		table.insert(lib.Dropdowns, dropdown)
	end

	dropdown:SetOpen(true)
	return dropdown
end

return Library
