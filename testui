function library:AddTab(name)
	local index = #self.tabs + 1
	local tabButton = create("TextButton", {
		Parent = self.tabList,
		Size = UDim2.new(1, -15, 0, 32),
		BackgroundColor3 = theme.buttonBackground,
		BackgroundTransparency = 1,
		Text = "   " .. name,
		TextColor3 = theme.textSecondary,
		Font = theme.font,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	addCorner(tabButton)
	tabButton.MouseEnter:Connect(function()
		if tabButton.BackgroundTransparency == 1 then
			TweenService:Create(tabButton, TweenInfo.new(0.15), {
				BackgroundTransparency = 0,
				BackgroundColor3 = Color3.fromRGB(20, 32, 44),
			}):Play()
		end
	end)
	tabButton.MouseLeave:Connect(function()
		if tabButton.TextColor3 ~= theme.textPrimary then
			TweenService:Create(tabButton, TweenInfo.new(0.15), {
				BackgroundTransparency = 1,
			}):Play()
		end
	end)
	local page = create("Frame", {
		Parent = self.content,
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Visible = index == 1,
	})
	local mainColumn = create("ScrollingFrame", {
		Parent = page,
		Size = UDim2.new(contentSplit, -4, 1, 0),
		Position = UDim2.new(0, 0, 0, 0),
		BackgroundTransparency = 1,
		ScrollBarThickness = 4,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(0, 0, 0, 0),
	})
	create("UIListLayout", { Parent = mainColumn, Padding = UDim.new(0, 8) })
	create("UIPadding", {
		Parent = mainColumn,
		PaddingTop = UDim.new(0, 8),
		PaddingLeft = UDim.new(0, 8),
		PaddingRight = UDim.new(0, 8),
	})
	create("Frame", {
		Parent = page,
		Size = UDim2.new(0, 1, 1, -12),
		Position = UDim2.new(contentSplit, 0, 0, 6),
		BackgroundColor3 = theme.divider,
		BorderSizePixel = 0,
	})
	local sideColumn = create("ScrollingFrame", {
		Parent = page,
		Size = UDim2.new(1 - contentSplit, -4, 1, 0),
		Position = UDim2.new(contentSplit, 4, 0, 0),
		BackgroundTransparency = 1,
		ScrollBarThickness = 4,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(0, 0, 0, 0),
	})
	create("UIListLayout", { Parent = sideColumn, Padding = UDim.new(0, 8) })
	create("UIPadding", {
		Parent = sideColumn,
		PaddingTop = UDim.new(0, 8),
		PaddingLeft = UDim.new(0, 8),
		PaddingRight = UDim.new(0, 8),
	})
	table.insert(self.tabs, { Button = tabButton, Page = page })
	table.insert(self.tabOffsets, 10 + (index - 1) * 37)
	tabButton.MouseButton1Click:Connect(function()
		self:SelectTab(index)
	end)
	return setmetatable({
		page = page,
		main = mainColumn,
		side = sideColumn,
		library = self,
	}, tab)
end
function library:SelectTab(index)
	self.selectedIndex = index
	for i, tabData in ipairs(self.tabs) do
		tabData.Page.Visible = (i == index)
		if i == index then
			TweenService:Create(tabData.Button, TweenInfo.new(0.15), {
				BackgroundTransparency = 0,
				BackgroundColor3 = theme.accentSelected,
				TextColor3 = theme.textPrimary,
			}):Play()
		else
			TweenService:Create(tabData.Button, TweenInfo.new(0.15), {
				BackgroundTransparency = 1,
				TextColor3 = theme.textSecondary,
			}):Play()
		end
	end
	TweenService:Create(self.indicator, TweenInfo.new(0.2), {
		Position = UDim2.new(0, 5, 0, self.tabOffsets[index] or 10),
	}):Play()
end
