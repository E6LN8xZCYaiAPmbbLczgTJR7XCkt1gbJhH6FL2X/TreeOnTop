function ct:AddSlider(ed, ee, ef, eg, eh, ei)
	local ej = self.Main
	ee = ee or 0
	ef = ef or 100
	eg = math.clamp(eg or ee, ee, ef)

	local ek = q("Frame", {
		Parent = ej,
		Size = UDim2.new(1, 0, 0, 46),
		BackgroundColor3 = f.ButtonBackground,
	})
	w(ek)
	z(ek, Color3.fromRGB(50, 50, 65), 1)

	q("TextLabel", {
