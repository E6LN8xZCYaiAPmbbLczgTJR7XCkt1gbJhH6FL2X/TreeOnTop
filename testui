function tab:AddSlider(label, min, max, default, callback, useSide)
	local parent = useSide and self.side or self.main
	min = min or 0
	max = max or 100
	default = math.clamp(default or min, min, max)
	local container = create("Frame", {
		Parent = parent,
		Size = UDim2.new(1, 0, 0, 52),
		BackgroundColor3 = theme.buttonBackground,
	})
	addCorner(container)
	addStroke(container, Color3.fromRGB(45, 62, 76), 1)
	create("TextLabel", {
		Parent = container,
		Size = UDim2.new(1, -70, 0, 20),
		Position = UDim2.new(0, 10, 0, 4),
		BackgroundTransparency = 1,
		Text = label,
		TextColor3 = theme.textMuted,
		Font = theme.fontBody,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	local valueBox = create("TextBox", {
		Parent = container,
		Size = UDim2.new(0, 50, 0, 20),
		Position = UDim2.new(1, -60, 0, 4),
		BackgroundColor3 = theme.inputBackground,
		TextColor3 = theme.textPrimary,
		Font = theme.fontBody,
		TextSize = 12,
		Text = tostring(default),
		ClearTextOnFocus = false,
	})
	addCorner(valueBox, 5)
	local track = create("Frame", {
		Parent = container,
		Size = UDim2.new(1, -20, 0, 6),
		Position = UDim2.new(0, 10, 1, -14),
		BackgroundColor3 = theme.inputBackground,
	})
	addCorner(track, 3)
	local fill = create("Frame", {
		Parent = track,
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = theme.accentFill,
	})
	addCorner(fill, 3)
	local thumb = create("Frame", {
		Parent = track,
		Size = UDim2.new(0, 12, 0, 12),
		Position = UDim2.new(0, -6, 0.5, -6),
		BackgroundColor3 = theme.textPrimary,
		ZIndex = 5,
	})
	addCorner(thumb, 6)
	local current = default
	local function setValue(value, skipText)
		value = math.clamp(value, min, max)
		current = value
		local alpha = (max - min) == 0 and 0 or (value - min) / (max - min)
		fill.Size = UDim2.new(alpha, 0, 1, 0)
		thumb.Position = UDim2.new(alpha, -6, 0.5, -6)
		if not skipText then
			valueBox.Text = tostring(math.floor(value * 100) / 100)
		end
		if callback then callback(value) end
	end
	setValue(default)
	local sliding = false
	local function updateFromX(x)
		local alpha = (x - track.AbsolutePosition.X) / track.AbsoluteSize.X
		setValue(min + alpha * (max - min))
	end
	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			sliding = true
			updateFromX(input.Position.X)
		end
	end)
	track.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			sliding = false
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			updateFromX(input.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			sliding = false
		end
	end)
	valueBox.FocusLost:Connect(function()
		local num = tonumber(valueBox.Text)
		if num then
			setValue(num, true)
			valueBox.Text = tostring(current)
		else
			valueBox.Text = tostring(current)
		end
	end)
	return {
		Set = setValue,
		Get = function() return current end,
	}
end
