		ZIndex = 2,
	})
	create("UIListLayout", { Parent = container, Padding = UDim.new(0, 4) })
	local headerBtn = create("TextButton", {
		Parent = container,
		Size = UDim2.new(1, 0, 0, 26),
		BackgroundColor3 = theme.buttonBackground,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 2,
	})
	addCorner(headerBtn)
	local headerLabel = create("TextLabel", {
		Parent = headerBtn,
		Size = UDim2.new(1, -10, 1, 0),
		Position = UDim2.new(0, 10, 0, 0),
		BackgroundTransparency = 1,
		Text = title .. "  " .. dropdownOpen,
		TextColor3 = theme.accentFill,
		Font = theme.fontBody,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 2,
	})
	local closeFrame = create("Frame", {
		Parent = container,
		Size = UDim2.new(1, 0, 0, 20),
		BackgroundTransparency = 1,
		ZIndex = 2,
	})
	local closeBtn = create("TextButton", {
		Parent = closeFrame,
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundColor3 = theme.inputBackground,
		Text = "Close  ×",
		TextColor3 = theme.textSecondary,
		Font = theme.fontBody,
		TextSize = 12,
		ZIndex = 2,
	})
	addCorner(closeBtn, 4)
	local list = create("ScrollingFrame", {
		Parent = container,
		Size = UDim2.new(1, 0, 0, 0),
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 4,
		BackgroundColor3 = theme.inputBackground,
		ClipsDescendants = true,
		Visible = true,
		ZIndex = 2,
	})
	addCorner(list, 6)
	create("UIListLayout", { Parent = list, Padding = UDim.new(0, optionPad) })
	create("UIPadding", {
		Parent = list,
		PaddingTop = UDim.new(0, 4),
		PaddingBottom = UDim.new(0, 4),
		PaddingLeft = UDim.new(0, 4),
		PaddingRight = UDim.new(0, 4),
	})
	local dropdown = {
		frame = container,
		content = list,
		multiSelect = multiSelect and true or false,
		selected = {},
		_options = {},
	}
	local isOpen = true
	local function updateHeight()
		local count = #dropdown._options
		local h = 0
		if count > 0 then
			h = math.min(count * optionHeight + (count - 1) * optionPad + 8, maxHeight)
		end
		list.Size = UDim2.new(1, 0, 0, h)
	end
	local function setZIndex(z)
		container.ZIndex = z
		headerBtn.ZIndex = z
		headerLabel.ZIndex = z
		closeFrame.ZIndex = z
		closeBtn.ZIndex = z
		list.ZIndex = z
		for _, child in ipairs(list:GetChildren()) do
			if child:IsA("GuiObject") then
				child.ZIndex = z
			end
		end
	end
	function dropdown:SetOpen(open)
		isOpen = open
		list.Visible = open
		closeFrame.Visible = open
		headerLabel.Text = title .. "  " .. (open and dropdownOpen or dropdownClosed)
		setZIndex(open and 10 or 2)
		if open and lib then
			for _, other in ipairs(lib.dropdowns) do
				if other ~= dropdown and other._IsExpanded and other._IsExpanded() then
					other:SetOpen(false)
				end
			end
		end
	end
	dropdown._IsExpanded = function()
		return isOpen
	end
	function dropdown:AddOption(text, callback)
		local optBtn = create("TextButton", {
			Parent = list,
			Size = UDim2.new(1, 0, 0, optionHeight),
			BackgroundTransparency = 1,
			Text = "  " .. text,
			TextColor3 = Color3.fromRGB(198, 214, 224),
			Font = Enum.Font.Gotham,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = isOpen and 10 or 2,
			AutoButtonColor = false,
		})
		local selected = false
		local optionRef
		local function refreshVisual()
			if selected then
				optBtn.BackgroundTransparency = 0
				optBtn.BackgroundColor3 = theme.accentSelected
				optBtn.TextColor3 = theme.textPrimary
				optBtn.Text = (dropdown.multiSelect and "✓ " or "  ") .. text
			else
				optBtn.BackgroundTransparency = 1
				optBtn.TextColor3 = Color3.fromRGB(198, 214, 224)
				optBtn.Text = "  " .. text
			end
		end
		local function setSelected(value)
			selected = value
			refreshVisual()
			dropdown.selected[text] = value or nil
		end
		optBtn.MouseEnter:Connect(function()
			if not selected then
				optBtn.BackgroundTransparency = 0
				optBtn.BackgroundColor3 = Color3.fromRGB(20, 32, 44)
			end
		end)
		optBtn.MouseLeave:Connect(function()
			if not selected then
				optBtn.BackgroundTransparency = 1
			end
		end)
		optBtn.Activated:Connect(function()
			if dropdown.multiSelect then
				setSelected(not selected)
				if callback then callback(selected) end
			else
				for _, opt in ipairs(dropdown._options) do
					if opt ~= optionRef then
						opt.SetSelected(false)
					end
				end
				setSelected(true)
				if callback then callback() end
			end
		end)
		optionRef = { Button = optBtn, Text = text, SetSelected = setSelected }
		table.insert(dropdown._options, optionRef)
		updateHeight()
		return optBtn
	end
	function dropdown:RemoveOption(button)
		if not button then return end
		for i, opt in ipairs(dropdown._options) do
			if opt.Button == button then
				dropdown.selected[opt.Text] = nil
				table.remove(dropdown._options, i)
				break
			end
		end
		button:Destroy()
		updateHeight()
	end
	function dropdown:Clear()
		for _, child in ipairs(list:GetChildren()) do
			if child:IsA("TextButton") then
				child:Destroy()
			end
		end
		dropdown._options = {}
		dropdown.selected = {}
		updateHeight()
	end
	function dropdown:GetSelected()
		local result = {}
		for _, opt in ipairs(dropdown._options) do
			if dropdown.selected[opt.Text] then
				table.insert(result, opt.Text)
			end
		end
		return result
	end
	headerBtn.Activated:Connect(function()
		dropdown:SetOpen(not isOpen)
	end)
	closeBtn.Activated:Connect(function()
		dropdown:SetOpen(false)
	end)
	if options then
		for _, opt in ipairs(options) do
			dropdown:AddOption(opt.Text, opt.Callback)
		end
	end
	if lib then
		table.insert(lib.dropdowns, dropdown)
	end
	dropdown:SetOpen(true)
	return dropdown
end
return library
