		Size = UDim2.new(1, -60, 0, 18),
		Position = UDim2.new(0, 8, 0, 4),
		BackgroundTransparency = 1,
		Text = ed,
		TextColor3 = f.TextMuted,
		Font = f.FontBody,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
	})

	local el = q("TextBox", {
		Parent = ek,
		Size = UDim2.new(0, 46, 0, 18),
		Position = UDim2.new(1, -54, 0, 4),
		BackgroundColor3 = f.InputBackground,
		TextColor3 = f.TextPrimary,
		Font = f.FontBody,
		TextSize = 11,
		Text = tostring(eg),
		ClearTextOnFocus = false,
	})
	w(el, 4)

	local em = q("Frame", {
		Parent = ek,
		Size = UDim2.new(1, -16, 0, 5),
		Position = UDim2.new(0, 8, 1, -12),
		BackgroundColor3 = f.InputBackground,
	})
	w(em, 3)

	local en = q("Frame", {
		Parent = em,
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = Color3.fromRGB(100, 100, 130),
	})
	w(en, 3)

	local eo = q("Frame", {
		Parent = em,
		Size = UDim2.new(0, 10, 0, 10),
		Position = UDim2.new(0, -5, 0.5, -5),
		BackgroundColor3 = f.TextPrimary,
		ZIndex = 5,
	})
	w(eo, 5)

	local ep = eg
	local function eq(er, es)
		er = math.clamp(er, ee, ef)
		ep = er
		local et = (ef - ee) == 0 and 0 or (er - ee) / (ef - ee)
		en.Size = UDim2.new(et, 0, 1, 0)
		eo.Position = UDim2.new(et, -5, 0.5, -5)
		if not es then
			el.Text = tostring(math.floor(er * 100) / 100)
		end
		if eh then eh(er) end
	end
	eq(eg)

	local eu = false
	local function ev(ew)
		local ex = (ew - em.AbsolutePosition.X) / em.AbsoluteSize.X
		eq(ee + ex * (ef - ee))
	end

	em.InputBegan:Connect(function(ey)
		if ey.UserInputType == Enum.UserInputType.MouseButton1 or ey.UserInputType == Enum.UserInputType.Touch then
			eu = true
			ev(ey.Position.X)
		end
	end)
	em.InputEnded:Connect(function(ez)
		if ez.UserInputType == Enum.UserInputType.MouseButton1 or ez.UserInputType == Enum.UserInputType.Touch then
			eu = false
		end
	end)
	b.InputChanged:Connect(function(fa)
		if eu and (fa.UserInputType == Enum.UserInputType.MouseMovement or fa.UserInputType == Enum.UserInputType.Touch) then
			ev(fa.Position.X)
		end
	end)
	b.InputEnded:Connect(function(fb)
		if fb.UserInputType == Enum.UserInputType.MouseButton1 or fb.UserInputType == Enum.UserInputType.Touch then
			eu = false
		end
	end)

	el.FocusLost:Connect(function()
		local fc = tonumber(el.Text)
		if fc then
			eq(fc, true)
			el.Text = tostring(ep)
		else
			el.Text = tostring(ep)
		end
	end)

	return { Set = eq, Get = function() return ep end }
end

