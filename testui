		ZIndex = 2,
	})
	w(fq, 4)

	local fr = q("ScrollingFrame", {
		Parent = fm,
		Size = UDim2.new(1, 0, 0, 0),
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 4,
		BackgroundColor3 = f.InputBackground,
		ClipsDescendants = true,
		Visible = true,
		ZIndex = 2,
	})
	w(fr, 6)
	q("UIListLayout", { Parent = fr, Padding = UDim.new(0, fk) })
	q("UIPadding", {
		Parent = fr,
		PaddingTop = UDim.new(0, 4),
		PaddingBottom = UDim.new(0, 4),
		PaddingLeft = UDim.new(0, 4),
		PaddingRight = UDim.new(0, 4),
	})

	local fs = { Frame = fm, Content = fr }
	fs.MultiSelect = fg and true or false
	fs.Selected = {}
	fs._options = {}
	local ft = true

	local function fu()
		local fv = #fs._options
		local fw = 0
		if fv > 0 then
			fw = math.min(fv * fj + (fv - 1) * fk + 8, fl)
		end
		fr.Size = UDim2.new(1, 0, 0, fw)
	end

	local function fx(fy)
		fm.ZIndex = fy
		fn.ZIndex = fy
		fo.ZIndex = fy
		fp.ZIndex = fy
		fq.ZIndex = fy
		fr.ZIndex = fy
		for _, fz in ipairs(fr:GetChildren()) do
			if fz:IsA("GuiObject") then
				fz.ZIndex = fy
			end
		end
	end

	function fs:SetOpen(ga)
		ft = ga
		fr.Visible = ga
		fp.Visible = ga
		fo.Text = fd .. "  " .. (ga and o or p)
		fx(ga and 10 or 2)

		if ga and fi then
			for _, gb in ipairs(fi.Dropdowns) do
				if gb ~= fs and gb._IsExpanded and gb._IsExpanded() then
					gb:SetOpen(false)
				end
			end
		end
	end
	fs._IsExpanded = function() return ft end

	function fs:AddOption(gc, gd)
		local ge = q("TextButton", {
			Parent = fr,
			Size = UDim2.new(1, 0, 0, fj),
			BackgroundTransparency = 1,
			Text = "  " .. gc,
			TextColor3 = Color3.fromRGB(198, 214, 224),
			Font = Enum.Font.Gotham,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = ft and 10 or 2,
			AutoButtonColor = false,
		})

		local gf = false
		local gg
		local function gh()
			if gf then
				ge.BackgroundTransparency = 0
				ge.BackgroundColor3 = f.AccentSelected
				ge.TextColor3 = f.TextPrimary
				ge.Text = (fs.MultiSelect and "\226\156\147 " or "  ") .. gc
			else
				ge.BackgroundTransparency = 1
				ge.TextColor3 = Color3.fromRGB(198, 214, 224)
				ge.Text = "  " .. gc
			end
		end
		local function gi(gj)
			gf = gj
			gh()
			fs.Selected[gc] = gj or nil
		end

		ge.MouseEnter:Connect(function()
			if not gf then
				ge.BackgroundTransparency = 0
				ge.BackgroundColor3 = Color3.fromRGB(20, 32, 44)
			end
		end)
		ge.MouseLeave:Connect(function()
			if not gf then
				ge.BackgroundTransparency = 1
			end
		end)

		ge.Activated:Connect(function()
			if fs.MultiSelect then
				gi(not gf)
				if gd then gd(gf) end
			else
				for _, gk in ipairs(fs._options) do
					if gk ~= gg then gk.SetSelected(false) end
				end
				gi(true)
				if gd then gd() end
			end
		end)

		gg = { Button = ge, Text = gc, SetSelected = gi }
		table.insert(fs._options, gg)
		fu()
		return ge
	end

	function fs:RemoveOption(gl)
		if not gl then return end
		for gm, gn in ipairs(fs._options) do
			if gn.Button == gl then
				fs.Selected[gn.Text] = nil
				table.remove(fs._options, gm)
				break
			end
		end
		gl:Destroy()
		fu()
	end

	function fs:Clear()
		for _, go in ipairs(fr:GetChildren()) do
			if go:IsA("TextButton") then go:Destroy() end
		end
		fs._options = {}
		fs.Selected = {}
		fu()
	end

	function fs:GetSelected()
		local gp = {}
		for _, gq in ipairs(fs._options) do
			if fs.Selected[gq.Text] then
				table.insert(gp, gq.Text)
			end
		end
		return gp
	end

	fn.Activated:Connect(function()
		fs:SetOpen(not ft)
	end)
	fq.Activated:Connect(function()
		fs:SetOpen(false)
	end)

	if fe then
		for _, gr in ipairs(fe) do
			fs:AddOption(gr.Text, gr.Callback)
		end
	end

	if fi then
		table.insert(fi.Dropdowns, fs)
	end

	fs:SetOpen(true)

	return fs
end

return e
