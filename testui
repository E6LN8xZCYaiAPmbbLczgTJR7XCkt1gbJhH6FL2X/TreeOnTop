local function q(r, s)
	local t = Instance.new(r)
	for u, v in pairs(s or {}) do
		t[u] = v
	end
	return t
end

local function w(x, y)
	return q("UICorner", { Parent = x, CornerRadius = UDim.new(0, y or h) })
end

local function z(aa, ab, ac)
	return q("UIStroke", { Parent = aa, Color = ab or f.AccentStroke, Thickness = ac or 1 })
end

local function ba(bb)
	bb = math.max(0, math.floor(bb))
	local bc = math.floor(bb / 86400)
	local bd = math.floor((bb % 86400) / 3600)
	local be = math.floor((bb % 3600) / 60)
	local bf = bb % 60
	return string.format("%dD %dH %dM %dS", bc, bd, be, bf)
end

