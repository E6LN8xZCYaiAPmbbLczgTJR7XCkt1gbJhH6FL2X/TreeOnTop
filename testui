function e:AddTab(cu)
	local cv = #self.Tabs + 1

	local cw = q("TextButton", {
		Parent = self.TabList,
		Size = UDim2.new(1, -10, 0, 26),
		BackgroundColor3 = f.ButtonBackground,
		BackgroundTransparency = 1,
		Text = "  " .. cu,
		TextColor3 = f.TextSecondary,
		Font = f.FontBody,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	w(cw)

	cw.MouseEnter:Connect(function()
		if cw.BackgroundTransparency == 1 then
			a:Create(cw, TweenInfo.new(0.12), {
				BackgroundTransparency = 0,
				BackgroundColor3 = Color3.fromRGB(35, 35, 45),
			}):Play()
		end
	end)
	cw.MouseLeave:Connect(function()
		if cw.TextColor3 ~= f.TextPrimary then
			a:Create(cw, TweenInfo.new(0.12), {
				BackgroundTransparency = 1,
			}):Play()
		end
	end)

	local cx = q("Frame", {
		Parent = self.Content,
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Visible = cv == 1,
	})

	-- Single full-width scrolling column
	local cy = q("ScrollingFrame", {
		Parent = cx,
		Size = UDim2.new(1, 0, 1, 0),
		Position = UDim2.new(0, 0, 0, 0),
		BackgroundTransparency = 1,
		ScrollBarThickness = 3,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(0, 0, 0, 0),
	})
	q("UIListLayout", { Parent = cy, Padding = UDim.new(0, 6) })
	q("UIPadding", {
		Parent = cy,
		PaddingTop = UDim.new(0, 8),
		PaddingLeft = UDim.new(0, 8),
		PaddingRight = UDim.new(0, 8),
		PaddingBottom = UDim.new(0, 8),
	})

	table.insert(self.Tabs, { Button = cw, Page = cx })
	table.insert(self.TabOffsets, 8 + (cv - 1) * 29)

	cw.MouseButton1Click:Connect(function()
		self:SelectTab(cv)
	end)

	local da = setmetatable({
		Page = cx,
		Main = cy,
		Side = cy, -- same as Main now (no split)
		Library = self,
	}, ct)
	return da
end

function e:SelectTab(db)
	self.SelectedIndex = db
	for dc, dd in ipairs(self.Tabs) do
		dd.Page.Visible = (dc == db)
		if dc == db then
			a:Create(dd.Button, TweenInfo.new(0.12), {
				BackgroundTransparency = 0,
				BackgroundColor3 = f.AccentSelected,
				TextColor3 = f.TextPrimary,
			}):Play()
		else
			a:Create(dd.Button, TweenInfo.new(0.12), {
				BackgroundTransparency = 1,
				TextColor3 = f.TextSecondary,
			}):Play()
		end
	end
	a:Create(self.Indicator, TweenInfo.new(0.15), {
		Position = UDim2.new(0, 4, 0, self.TabOffsets[db] or 8),
	}):Play()
end

