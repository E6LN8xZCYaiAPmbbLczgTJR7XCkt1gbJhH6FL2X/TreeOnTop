local function ba(bb)
	bb = math.max(0, math.floor(bb))
	local bc = math.floor(bb / 86400)
	local bd = math.floor((bb % 86400) / 3600)
	local be = math.floor((bb % 3600) / 60)
	local bf = bb % 60
	return string.format("%dD / %dH / %dM / %dS", bc, bd, be, bf)
end

