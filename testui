function e:SelectTab(db)
	self.SelectedIndex = db
	for dc, dd in ipairs(self.Tabs) do
		dd.Page.Visible = (dc == db)
		if dc == db then
			a:Create(dd.Button, TweenInfo.new(0.15), {
				BackgroundTransparency = 0,
				BackgroundColor3 = f.AccentSelected,
				TextColor3 = f.TextPrimary,
			}):Play()
		else
			a:Create(dd.Button, TweenInfo.new(0.15), {
				BackgroundTransparency = 1,
				TextColor3 = f.TextSecondary,
			}):Play()
		end
	end
	a:Create(self.Indicator, TweenInfo.new(0.2), {
		Position = UDim2.new(0, 5, 0, self.TabOffsets[db] or 10),
	}):Play()
end

