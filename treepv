	if not fl then return 0 end
	local fm = 1
	if fk:FindFirstChild("ultimatesFolder") and fk.ultimatesFolder:FindFirstChild("Infernal Health") then
		fm = fm + 0.15 * (fk.ultimatesFolder["Infernal Health"].Value or 0)
	end
	if fk:FindFirstChild("equippedPets") then
		for _, fn in ipairs(fk.equippedPets:GetChildren()) do
			if fn:IsA("ObjectValue") and fn.Value then
				if string.lower(fn.Value.Name):match("mighty") and string.lower(fn.Value.Name):match("monster") then
					fm = fm + 0.5
				end
				if string.lower(fn.Value.Name):match("small") and string.lower(fn.Value.Name):match("fry") then
					fm = fm + 0.25
				end
			end
		end
	end
	return fl.Value * fm
end

local function fo(fp)
	if not fp then return 0 end
	if not fp:FindFirstChild("leaderstats") or not fp.leaderstats:FindFirstChild("Strength") then return 0 end
	local fq = fp.leaderstats.Strength.Value * 0.066666666666666666666666666666666666666666666667
	local fr = 1
	if fp:FindFirstChild("ultimatesFolder") and fp.ultimatesFolder:FindFirstChild("Demon Damage") then
		fr = fr + 0.1 * (fp.ultimatesFolder["Demon Damage"].Value or 0)
	end
	if fp:FindFirstChild("equippedPets") then
		for _, fs in ipairs(fp.equippedPets:GetChildren()) do
			if fs:IsA("ObjectValue") and fs.Value then
				if string.lower(fs.Value.Name):match("wild") and string.lower(fs.Value.Name):match("wizard") then
					fr = fr + 0.5
				end
				if string.lower(fs.Value.Name):match("chaos") and string.lower(fs.Value.Name):match("sorcerer") then
					fr = fr + 0.25
				end
			end
		end
	end
	return fq * fr
end

local function ft(fu)
	if not fu then
		ez:SetTitle("Enemy Health: N/A")
		fa:SetTitle("Enemy Damage: N/A")
		fb:SetTitle("Your Health: N/A")
		fc:SetTitle("Your Damage: N/A")
		fd:SetTitle("Hits To Kill: N/A")
		return
	end
	fe = fj(fu)
	ff = fo(fu)
	fg = fj(c)
	fh = fo(c)
	fi = fh <= 0 and "∞" or (math.ceil(fe / fh) > 200 and "∞" or 
		(math.ceil(fe / fh) < 1 and "instant" or math.ceil(fe / fh)))
	ez:SetTitle(string.format("Enemy Health: %s (%s)", eb(fe), ed(fe)))
	fa:SetTitle(string.format("Enemy Damage: %s (%s)", eb(ff), ed(ff)))
	fb:SetTitle(string.format("Your Health: %s (%s)", eb(fg), ed(fg)))
	fc:SetTitle(string.format("Your Damage: %s (%s)", eb(fh), ed(fh)))
	fd:SetTitle(string.format("Hits To Kill: %s", tostring(fi)))
end

task.spawn(function()
	while true do
		ft(eh)
		task.wait(0.01)
	end
end)
