local function eb(ec)
	if ec >= 1e15 then return string.format("%.1fqa", ec / 1e15)
	elseif ec >= 1e12 then return string.format("%.1ft", ec / 1e12)
	elseif ec >= 1e9 then return string.format("%.1fb", ec / 1e9)
	elseif ec >= 1e6 then return string.format("%.1fm", ec / 1e6)
	elseif ec >= 1e3 then return string.format("%.1fk", ec / 1e3)
	else return tostring(ec) end
end

local function ed(ee)
	local ef = tostring(math.floor(ee))
	local eg
	while true do
		ef, eg = ef:gsub("^(-?%d+)(%d%d%d)", "%1,%2")
		if eg == 0 then break end
	end
	return ef
end

