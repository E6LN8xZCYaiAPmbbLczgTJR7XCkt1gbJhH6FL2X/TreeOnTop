		if not cm and getgenv().SpectateState.SavedUserId then
			for _, co in ipairs(b:GetPlayers()) do
				if co.UserId == getgenv().SpectateState.SavedUserId then
					cm = co
					bz = cm
					ca = co.UserId
					break
