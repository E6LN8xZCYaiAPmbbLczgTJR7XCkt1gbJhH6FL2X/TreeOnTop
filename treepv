			if not _G.tpKillConnection then
				_G.tpKillConnection = RunService.Heartbeat:Connect(function()
					if not _G.killTpListed then return end
					local character = checkCharacter()
					local hrp = character and character:FindFirstChild("HumanoidRootPart")
					if not hrp then return end
					for _, name in ipairs(_G.tpListedPlayers) do
						local target = nil
						for _, p in ipairs(Players:GetPlayers()) do
							if p.Name:lower() == name:lower() then
								target = p
