local function updateStatLabels(targetPlayer)
	if not targetPlayer then return end
	playerNameLabel:SetTitle("Name: " .. targetPlayer.DisplayName)
	if not targetPlayer:FindFirstChild("leaderstats") then return end
	local function updateOne(label, emoji, name, statName)
		local statObject = targetPlayer.leaderstats:FindFirstChild(statName) or targetPlayer:FindFirstChild(statName)
		if statObject then
			label:SetTitle(string.format("%s %s: %s (%s)", emoji, name, 
				formatNumber(statObject.Value), formatWithCommas(statObject.Value)))
		else
			label:SetTitle(emoji .. " " .. name .. ": 0 (0)")
		end
	end
	updateOne(StrengthLabel, EmojiStrength, "Strength", "Strength")
	updateOne(DurabilityLabel, EmojiDurability, "Durability", "Durability")
end

