getgenv().SpectateState = getgenv().SpectateState or {}
getgenv().SpectateState.SavedUserId = getgenv().SpectateState.SavedUserId or nil
getgenv().SpectateState.IsSpectating = getgenv().SpectateState.IsSpectating or false

local function stopSpectating()
	if CurrentTargetConnection then
		CurrentTargetConnection:Disconnect()
		CurrentTargetConnection = nil
	end
	if CameraMonitorLoop then
		CameraMonitorLoop = false
	end
	local localPlayer = Players.LocalPlayer
	if localPlayer.Character then
		local humanoid = localPlayer.Character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			Camera.CameraSubject = humanoid
			Camera.CameraType = Enum.CameraType.Custom
		end
	end
	if Humanoid then
		Camera.CameraSubject = Humanoid
	end
end

local function startCameraMonitor()
	if CameraMonitorLoop then
		CameraMonitorLoop = false
		task.wait(0.03)
	end
	CameraMonitorLoop = true
	task.spawn(function()
		while CameraMonitorLoop do
			task.wait(0.02)
			if Spectating and SelectedPlayer then
				local targetChar = SelectedPlayer.Character
				if targetChar then
					local targetHumanoid = targetChar:FindFirstChildOfClass("Humanoid")
					if targetHumanoid then
						if Camera.CameraSubject ~= targetHumanoid then
							Camera.CameraSubject = targetHumanoid
						end
					end
				end
			else
				break
			end
		end
	end)
end

local function updateSpectateTarget(player)
	if not player then
		if SelectedPlayerUserId then
			for _, p in ipairs(Players:GetPlayers()) do
				if p.UserId == SelectedPlayerUserId then
					player = p
					SelectedPlayer = player
					break
				end
			end
		end
		if not player and getgenv().SpectateState.SavedUserId then
			for _, p in ipairs(Players:GetPlayers()) do
				if p.UserId == getgenv().SpectateState.SavedUserId then
					player = p
					SelectedPlayer = player
					SelectedPlayerUserId = p.UserId
					break
				end
			end
		end
		if not player then
			stopSpectating()
			return
		end
	end
	SelectedPlayerUserId = player.UserId
	SelectedPlayer = player
	if CurrentTargetConnection then
		CurrentTargetConnection:Disconnect()
		CurrentTargetConnection = nil
	end
	local function setCamera(char)
		if not Spectating or SelectedPlayerUserId ~= player.UserId then
			return
		end
		local humanoid = char:WaitForChild("Humanoid", 3)
		if humanoid and Spectating and SelectedPlayerUserId == player.UserId then
			Camera.CameraSubject = humanoid
		end
	end
	if player.Character then
		setCamera(player.Character)
	end
	CurrentTargetConnection = player.CharacterAdded:Connect(function(newChar)
		if Spectating and SelectedPlayerUserId == player.UserId then
			setCamera(newChar)
		end
	end)
end

local function updatePlayerList()
	return Players:GetPlayers()
end

local function getAllPlayerOptions()
	local options = {}
	for _, player in ipairs(updatePlayerList()) do
		table.insert(options, player.DisplayName .. " | " .. player.Name)
	end
	return options
end

local specsdropdown = KillingTab:Dropdown({
	Title = "Choose Player",
	Values = getAllPlayerOptions(),
	Callback = function(text)
		for _, player in ipairs(updatePlayerList()) do
			local optionText = player.DisplayName .. " | " .. player.Name
			if text == optionText then
				SelectedPlayer = player
				SelectedPlayerUserId = player.UserId
				getgenv().SpectateState.SavedUserId = player.UserId
				if Spectating then
					updateSpectateTarget(player)
				end
				break
			end
		end
	end
})

KillingTab:Toggle({
	Title = "Spectate",
	Value = false,
	Callback = function(bool)
		Spectating = bool
		getgenv().SpectateState.IsSpectating = bool
		if Spectating then
			if SelectedPlayerUserId then
				getgenv().SpectateState.SavedUserId = SelectedPlayerUserId
			end
			updateSpectateTarget()
			startCameraMonitor()
		else
			stopSpectating()
			task.wait(0.01)
			local localPlayer = Players.LocalPlayer
			if localPlayer.Character then
				local humanoid = localPlayer.Character:FindFirstChildOfClass("Humanoid")
				if humanoid then
					Camera.CameraSubject = humanoid
				end
			end
			getgenv().SpectateState.IsSpectating = false
		end
	end
})

Players.PlayerAdded:Connect(function(player)
	specsdropdown:Refresh(getAllPlayerOptions())
	if getgenv().SpectateState.IsSpectating and getgenv().SpectateState.SavedUserId == player.UserId then
		Spectating = true
		SelectedPlayer = player
		SelectedPlayerUserId = player.UserId
		updateSpectateTarget(player)
	end
end)

Players.PlayerRemoving:Connect(function(player)
	specsdropdown:Refresh(getAllPlayerOptions())
	if player.UserId == SelectedPlayerUserId then
		if Spectating then
			stopSpectating()
			SelectedPlayer = nil
			CurrentTargetConnection = nil
			local localPlayer = Players.LocalPlayer
			if localPlayer.Character and Humanoid then
				Camera.CameraSubject = Humanoid
			end
		end
	end
end)

